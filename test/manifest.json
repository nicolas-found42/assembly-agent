      "note": "Legacy manual Chrome/axe harness (developer-local browser, network-dependent outcomes). Superseded by the required Playwright suite in test/browser/; must never enter a required class."
    },
    {
      "path": "test/browser/",
      "kind": "suite",
      "class": "browser",
      "run": "playwright"
    },
    {
      "path": "test/browser/cross-browser/",
      "kind": "suite",
      "class": "scheduled-browser",
      "run": "playwright",
      "timeout": 600000,
      "note": "Same suite as test/browser/, declaring chromium+firefox+webkit for the scheduled/manual cross-browser workflow; the required class runs chromium only. timeout is explicit: the two engines take 4-5 minutes here and sit far too close to the 300 s default, which turned the class into a timing flake."
    },
    {
      "path": "test/worker/",
      "kind": "suite",
      "class": "worker",
      "run": "vitest-config"
    },
